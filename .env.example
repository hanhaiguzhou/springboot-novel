# ===================================================
# 环境变量配置示例
# 复制: cp .env.example .env 并填入你的真实值
# ===================================================

# SiliconFlow API Key (AI 功能需要)
# 获取地址: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-your-api-key-here

# Elasticsearch 密码 (可选,默认不开启 ES)
ES_PASSWORD=

# RabbitMQ 地址 (可选,默认不开启 MQ)
RABBITMQ_ADDRESSES=amqp://guest:guest@localhost

# MySQL 数据库 (默认 root/123456,仅本地开发)
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=novel
